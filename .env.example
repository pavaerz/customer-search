# Solo per una nuova installazione: copia in .env, senza sovrascrivere un file esistente.
# Non condividere chiavi. I valori esportati nel Terminale hanno precedenza.
PORT=8765

# Provider di ricerca: scegli Serper nelle impostazioni; le chiamate usano crediti.
SERPER_API_KEY=

# Provider AI REMOTE: configura modello, endpoint, modalità e budget nell'app.
# Inserire la chiave non abilita automaticamente l'AI né avvia campagne.
CUSTOMERSEARCH_AI_API_KEY=

# Lighthouse locale: facoltativi se Node/Lighthouse/Chrome sono rilevati automaticamente
LIGHTHOUSE_NODE=
LIGHTHOUSE_CLI=
CHROME_PATH=
