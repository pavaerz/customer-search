# Copia in .env e compila localmente. Non condividere queste credenziali.
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Registra esattamente questo URI nel client OAuth Google di tipo Applicazione web.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback
PORT=8765

# Facoltativo: secondo motore, crediti iniziali non mensili
SERPER_API_KEY=

# Prima fonte, locale e senza crediti API
SEARXNG_URL=http://127.0.0.1:8888

# Lighthouse locale: facoltativi se Node/Lighthouse/Chrome sono rilevati automaticamente
LIGHTHOUSE_NODE=
LIGHTHOUSE_CLI=
CHROME_PATH=
